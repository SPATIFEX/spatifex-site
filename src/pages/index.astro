---
        import BaseLayout from '../layouts/BaseLayout.astro';
        import Status from '../components/Status.astro';
        const lang = 'en';
        ---
        <BaseLayout lang={lang} title="Spatifex — Spatial software for architecture, engineering and construction." description="Spatial software for architecture, engineering and construction.">
          <section class="shell hero">
            <div><p class="eyebrow">Spatifex</p><Status label="In development" /></div>
            <h1>Spatial software for architecture, engineering and construction.</h1>
            <p class="lede">Spatifex develops dependable spatial software foundations: the Viewer runtime, controlled BIM derivatives and the engineering systems behind Plyten.</p>
            <div class="actions"><a class="button primary" href="/products/">Explore the direction</a></div>
          </section>
          <section class="shell"><h2 class="sr-only">Core directions</h2><div class="grid"><article class="card"><h3>Viewer engineering</h3><p>A That Open-based runtime with explicit lifecycle, compatibility and resource ownership.</p></article>
<article class="card"><h3>Controlled BIM data</h3><p>Raw sources remain preserved while display derivatives stay reproducible and inspectable.</p></article>
<article class="card"><h3>Platform foundations</h3><p>Open formats, replaceable infrastructure and self-hosted deployment remain first-class constraints.</p></article></div></section>
        </BaseLayout>
