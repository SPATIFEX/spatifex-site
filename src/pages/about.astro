---
import BaseLayout from '../layouts/BaseLayout.astro';
import Status from '../components/Status.astro';
const lang = 'en';
---
<BaseLayout lang={lang} title="About — Spatifex" description="Spatifex builds web-native tools for architecture, engineering and construction.">
  <section class="shell hero">
    <div><p class="eyebrow">Spatifex</p><Status label="Direction" /></div>
    <h1>About</h1>
    <p class="lede">Spatifex builds web-native tools for architecture, engineering and construction.</p>
  </section>
  <section class="shell"><article class="card"><h2>Current status</h2><p>This surface develops in parallel with the platform and will grow only with evidence-backed material.</p></article></section>
</BaseLayout>
