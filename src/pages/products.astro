---
import BaseLayout from '../layouts/BaseLayout.astro';
import Status from '../components/Status.astro';
const lang = 'en';
---
<BaseLayout lang={lang} title="Products — Spatifex" description="Spatifex develops Plyten and Spatifex Viewer as connected but independently governed products.">
  <section class="shell hero">
    <div><p class="eyebrow">Spatifex</p><Status label="Direction" /></div>
    <h1>Products</h1>
    <p class="lede">Spatifex develops Plyten and Spatifex Viewer as connected but independently governed products.</p>
  </section>
  <section class="shell"><article class="card"><h2>Current status</h2><p>This surface develops in parallel with the platform and will grow only with evidence-backed material.</p></article></section>
</BaseLayout>
