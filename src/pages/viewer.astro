---
import BaseLayout from '../layouts/BaseLayout.astro';
import Status from '../components/Status.astro';
const lang = 'en';
---
<BaseLayout lang={lang} title="Spatifex Viewer — Spatifex" description="Spatifex Viewer is a browser-based spatial runtime built on That Open for BIM viewing and interaction.">
  <section class="shell hero">
    <div><p class="eyebrow">Spatifex</p><Status label="Direction" /></div>
    <h1>Spatifex Viewer</h1>
    <p class="lede">Spatifex Viewer is a browser-based spatial runtime built on That Open for BIM viewing and interaction.</p>
  </section>
  <section class="shell"><article class="card"><h2>Current status</h2><p>This surface develops in parallel with the platform and will grow only with evidence-backed material.</p></article></section>
</BaseLayout>
