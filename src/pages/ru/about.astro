---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Status from '../../components/Status.astro';
const lang = 'ru';
---
<BaseLayout lang={lang} title="О компании — Spatifex" description="Spatifex создаёт web-native инструменты для архитектуры, инженерии и строительства.">
  <section class="shell hero">
    <div><p class="eyebrow">Spatifex</p><Status label="Направление" /></div>
    <h1>О компании</h1>
    <p class="lede">Spatifex создаёт web-native инструменты для архитектуры, инженерии и строительства.</p>
  </section>
  <section class="shell"><article class="card"><h2>Текущий статус</h2><p>Эта поверхность развивается параллельно с платформой и будет пополняться только подтверждёнными материалами.</p></article></section>
</BaseLayout>
