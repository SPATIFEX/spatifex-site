name: Deploy to GitHub Pages
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@REPLACE_WITH_REVIEWED_FULL_COMMIT_SHA # Pin to reviewed full SHA before activation.
      - uses: withastro/action@REPLACE_WITH_REVIEWED_FULL_COMMIT_SHA # Pin to reviewed full SHA before activation.
  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@REPLACE_WITH_REVIEWED_FULL_COMMIT_SHA # Pin to reviewed full SHA before activation.
